# Copy to .env and adjust. Read by `npm run start:dev` (dotenv-cli).

# --- http ---
PORT=3000
HOST=0.0.0.0
# comma separated list, or *
CORS_ORIGINS=*
SWAGGER=true
SEED=true

# --- authentication (Keycloak) ---
# tokens are verified against <KEYCLOAK__URL>/realms/<KEYCLOAK__REALM>/protocol/openid-connect/certs
KEYCLOAK__URL=http://localhost:8180
KEYCLOAK__REALM=decaf
KEYCLOAK__CLIENT_ID=decaf-backend
# explicit JWKS url (overrides the Keycloak-derived one)
# JWT__VERIFY_URL=
# HS256 shared secret, only used when no JWKS url is configured
# JWT__SECRET=
JWT__CLOCK_TOLERANCE_SECONDS=5
# NEVER in production: accept tokens without verifying their signature
JWT__ALLOW_DECODE_ONLY=false
# emit OCSF-style access logs (class_uid 3001/3002)
LOG_ACCESS=false

# --- live events (SSE) ---
EVENTS__ENABLED=true
EVENTS__PATH=/events
EVENTS__SUBSCRIPTION_MODE=false
EVENTS__AUTHENTICATE=true
